+    if terminal.get("backend") != "ssh":
+        raise _terminal_error()
+    host = terminal.get("ssh_host")
+    user = terminal.get("ssh_user")
+    port = terminal.get("ssh_port")
+    key = terminal.get("ssh_key")
+    config = terminal.get("ssh_config")
