+    case " $args " in *" --user-data-dir=$profile "*) ;; *) return 1 ;; esac
+    stat=$(cat "/proc/$p/stat" 2>/dev/null) || return 1
+    # After stripping "pid (comm) ", $4 is sid (setsid leader) and ${20} is starttime.
+    set -- ${stat##*) }
+    [ "$4" = "$p" ] && [ -n "${20}" ] || return 1
+    printf '%s %s\n' "$p" "${20}"
