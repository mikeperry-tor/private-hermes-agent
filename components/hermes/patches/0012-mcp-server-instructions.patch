     # Skills are runtime-mutable, so the index leads the volatile band: on a longest-prefix
     # backend an unchanged index stays inside the reused prefix; a changed one re-prefills from here.
-    volatile_parts: list[str] = [skills_prompt, *_memory_parts(agent)]
+    volatile_parts: list[str] = [skills_prompt]
+    mcp_instructions = _mcp_instructions_part(agent)
+    if mcp_instructions:
+        volatile_parts.append(mcp_instructions)
+    volatile_parts.extend(_memory_parts(agent))
     # Plugin sections are confined to one coarse anchor in the volatile tail so
     # a resumed process can reconstruct the stable prefix without re-running plugins.
     volatile_parts.extend(_plugin_section_blocks(_frozen_plugin_prompt_sections(agent), "after_memory"))
diff --git a/tools/mcp_tool_discovery.py b/tools/mcp_tool_discovery.py
index 8329e3d..2dea054 100644
--- a/tools/mcp_tool_discovery.py
+++ b/tools/mcp_tool_discovery.py
@@ -959,3 +959,30 @@ def get_registered_mcp_server_names() -> set:
     """Server names that registered at least one tool (live, filtered — not config.yaml)."""
     with _core._lock:
         return set(_core._mcp_tool_server_names.values())
+
+
+def get_mcp_server_instructions(
+    tool_names: Set[str] | frozenset[str], *, scope: Optional[str] = None
+) -> list[tuple[str, str]]:
+    """Return sorted ``(server_name, raw_instructions)`` pairs for connected MCP
+    servers that own at least one tool in *tool_names* and are visible in *scope*."""
+    if not tool_names:
+        return []
+    if scope is None:
+        scope = _core._mcp_registry_scope()
+    with _core._lock:
+        server_names = {
+            _core._mcp_tool_server_names[name]
+            for name in tool_names
+            if name in _core._mcp_tool_server_names
+        }
+        if not server_names:
+            return []
+        results: list[tuple[str, str]] = []
+        for server_name in sorted(server_names):
+            key = _resolve_server_key(server_name, scope, current=False)
+            server = _core._servers.get(key)
+            raw = getattr(getattr(server, "initialize_result", None), "instructions", None)
+            if isinstance(raw, str) and raw.strip():
+                results.append((server_name, raw))
+        return results
