# Private Hermes Stack Settings
#
# Copy this template to .env prior to running the stack.
# (`make init` will perform this copy).
#
# For values to take effect, you must cycle the stack:
#   make down
#   make up


# Container engine: docker or podman.
#
# An exported CONTAINER_ENGINE overrides this line, for example:
# CONTAINER_ENGINE=podman make test.
CONTAINER_ENGINE=docker

# Set COMPOSE_PROJECT_NAME to pick a custom container engine project
# prefix for this instance. Separate instances must use distinct project
# prefixes.
#
# WARNING: Do not change COMPOSE_PROJECT_NAME on an initialized instance.
# Named database volumes are scoped to the project name.
#COMPOSE_PROJECT_NAME=private-hermes

# Set NETWORK_PREFIX to a custom two-octet RFC1918 prefix (10.<0-255> except
# 10.204, 172.<16-31>, or 192.168) to avoid collisions with other compose
# stacks or other Private Hermes instances.
#NETWORK_PREFIX=10.203

# You can disable teep when using local inference.
TEEP_ENABLED=true
TEEP_HOST_PORT=8337
# Optional extra teep serve arguments, e.g. --log-level debug.
TEEP_SERVE_ARGS=

# Recommended inference: NearAI through teep's neardirect provider.
# Provider keys are supplied only to teep.
NEARAI_API_KEY=
# Other teep providers are optional alternatives.
VENICE_API_KEY=
TINFOIL_API_KEY=
CHUTES_API_KEY=
NANOGPT_API_KEY=
PHALA_API_KEY=

# Initial model when setup creates a new Hermes profile with Teep enabled.
# Leave blank to choose an initial model in Hermes.
TEEP_INSTALL_MODEL=neardirect:z-ai/glm-5.3-flash

# Local Inference and Local MCP support.
#
# Optionally allow a comma-separated set of ports on host.docker.internal.
# Hermes inference, tools, and plugins can use these ports. The code
# execution sandbox cannot connect directly.
HERMES_INTEGRATIONS_ALLOWED_HOST_PORTS=none

# Optionally allow a comma-separated list of IP:Port pairs of LAN addresses
# to be reached from Hermes harness.
HERMES_INTEGRATIONS_LAN_ENDPOINTS=none

# Optional Linux desktop inside the code executor; true selects the larger
# desktop image and enables computer_use/browser_exec tools.
COMPUTER_USE_ENABLED=false

# Optional read-write project directories to share with the agent's code
# executor sandbox. Leave blank for no extra shares.
# make up grants structured SSH edits under /workspace and the applied destinations.
#
# Use comma-separated absolute host:executor pairs with destinations below
# /mnt/projects/. For example:
# CODE_EXECUTOR_BIND_MOUNTS='/home/me/my-app:/mnt/projects/my-app,/home/me/notes:/mnt/projects/notes'
#
# NOTE: Read docs/configuration.md#security-considerations-for-shared-projects
# before co-working with your agent; git in particular provides numerous ways
# for untrusted repositories to execute arbitrary code.
CODE_EXECUTOR_BIND_MOUNTS=

# Host webapp listen address and port
WEBAPP_BIND=127.0.0.1
WEBAPP_PORT=9120
WEBAPP_USERNAME=admin

# WEBAPP_EXTERNAL_CONTENT governs how the webapp loads external content in
# preview panes and inline images.
#
# There are four values: tor_proxied, ask, off, browser_native.
#
# The agent tools for showing you website previews in the browser are disabled
# unless WEBAPP_EXTERNAL_CONTENT=browser_native.
#
# WARNING: browser_native loads external content over YOUR browser connection,
# outside the stack's Tor gateway. Use only with Tor Browser or Brave Browser's
# Private Window with Tor. The stack does not auto-detect the use of these
# browsers.
WEBAPP_EXTERNAL_CONTENT=tor_proxied

# WebApp and make chat shells: code (executor, default) or agent (administration).
# Apply with make up, then reload browser tabs and reopen make chat.
WEBAPP_TERMINAL_ENVIRONMENT=code

# Optionally enable a Tor Onion Service for ingress.
# Run `make onion-address` before enabling.
TOR_ONION_ENABLED=false

# Optional public HTTPS via Tailscale Funnel. Only the Tailscale container gets its key.
TAILSCALE_FUNNEL_ENABLED=false
TAILSCALE_HOSTNAME=private-hermes
TAILSCALE_FUNNEL_HOST=
TAILSCALE_FUNNEL_PORT=443
TS_AUTHKEY=
