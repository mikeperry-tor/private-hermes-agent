# Operator settings only. Image/source versions live in Compose and component Dockerfiles.
# This file is read by Compose; only explicitly selected variables reach each service.

# Container engine: docker (default) or podman (rootless, local). An exported
# CONTAINER_ENGINE overrides this line, for example CONTAINER_ENGINE=podman make test.
CONTAINER_ENGINE=docker

# Recommended inference: NearAI through teep's neardirect provider.
# Set NEARAI_API_KEY for the default model. Provider keys are supplied only to teep.
# Optional saved default (any model supported by configured teep providers).
# Blank preserves Hermes's saved selection. Apply changes with make up.
HERMES_DEFAULT_MODEL=
# Optional extra teep serve arguments, e.g. --log-level debug. Apply with make up.
TEEP_SERVE_ARGS=
TEEP_HOST_PORT=8337
NEARAI_API_KEY=
# Other teep providers are optional alternatives.
VENICE_API_KEY=
CHUTES_API_KEY=
TINFOIL_API_KEY=
NANOGPT_API_KEY=
PHALA_API_KEY=

# Optional desktop inside the SSH executor; true selects the larger desktop image
# and enables qualified computer_use/browser_exec tools. Apply with make up (rebuild/recreate).
COMPUTER_USE_ENABLED=false

# Treasury initialization/restoration and funding remain explicit operator actions.
# Wallet keys remain in a private named volume; SSH identities and the MCP token use separate data/ directories.

# Authenticated local webapp (enabled by default; make init creates credentials).
WEBAPP_BIND=127.0.0.1
WEBAPP_PORT=9120
WEBAPP_USERNAME=admin

# WEBAPP_EXTERNAL_CONTENT governs how the webapp loads external content in preview panes and
# inline images.
#
# There are four values: tor_proxied, ask, off, browser_native.
#
# The agent tools for showing you website previews in the browser are disabled
# unless WEBAPP_EXTERNAL_CONTENT=browser_native.
#
# WARNING: browser_native loads external content over YOUR browser connection,
# outside the stack's Tor gateway. Use only with Tor Browser or Brave Browser's
# Private Window with Tor. The stack does not auto-detect the use of these
# browsers.
WEBAPP_EXTERNAL_CONTENT=tor_proxied

# Ordinary browser terminal: code (SSH executor, default) or agent (administration).
# Apply with make up, then reload browser tabs.
WEBAPP_TERMINAL_ENVIRONMENT=code

# Onion ingress is independent of Funnel. The normal stack build includes Tor;
# run make onion-address before enabling. Identity creation alone does not publish
# the service.
TOR_ONION_ENABLED=false
# Optional public HTTPS via Tailscale Funnel. Only the Tailscale container gets its key.
TAILSCALE_FUNNEL_ENABLED=false
TAILSCALE_HOSTNAME=private-hermes
TAILSCALE_FUNNEL_HOST=
TAILSCALE_FUNNEL_PORT=443
TS_AUTHKEY=
